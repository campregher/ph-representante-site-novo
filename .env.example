# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=troque-por-senha-forte

# ── E-mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PH Representante <contato@seudominio.com.br>
LEAD_NOTIFICATION_EMAIL=contato@seudominio.com.br
EMAIL_ADMIN=contato@seudominio.com.br
# Gere com: openssl rand -hex 32
EMAIL_ACTION_SECRET=troque-por-segredo-aleatorio

# ── Mercado Livre OAuth (portal do seller /drop) ──────────────────────────────
ML_APP_ID=000000000000000
ML_CLIENT_SECRET=xxxxxxxxxxxx
# Callback do seller (whitelist no painel ML Developer)
ML_PORTAL_REDIRECT_URI=https://seudominio.com.br/api/drop/ml/callback
# Callback da conta ML da EMPRESA (whitelist no painel ML Developer) — usado
# em /sistema/estoque/produtos/importar-ml pro admin puxar os próprios anúncios
ML_REDIRECT_URI=https://seudominio.com.br/api/sistema/ml/callback

# ── Cron (Vercel) ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
CRON_SECRET=troque-por-segredo-aleatorio

# ── Google Sheets (leads) ─────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@projeto.iam.gserviceaccount.com
# Cole apenas a chave privada com \n nos saltos de linha
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...==\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=ID_DA_PLANILHA
GOOGLE_SHEETS_SHEET_NAME=Leads

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
META_PHONE_NUMBER_ID=000000000000000
META_WABA_ID=000000000000000
META_ACCESS_TOKEN=EAA...
META_WEBHOOK_VERIFY_TOKEN=token-aleatorio
