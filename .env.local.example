# YouTube Data API v3
# Copie este arquivo para .env.local e preencha os valores

# Chave de API do Google Cloud Console
# Passo a passo:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto (ou use um existente)
#   3. Ative a "YouTube Data API v3" em APIs & Services > Library
#   4. Crie uma credencial: APIs & Services > Credentials > Create Credentials > API key
#   5. (Recomendado) Restrinja a chave para a YouTube Data API v3
YOUTUBE_API_KEY=SUA_CHAVE_AQUI

# ID do canal do YouTube
# Como encontrar:
#   1. Acesse seu canal no YouTube
#   2. Clique em "Personalizar canal" ou vá em Configurações > Informações do canal avançadas
#   3. Copie o "ID do canal" (começa com UC...)
#   OU: acesse youtube.com/@seuhandle/about e veja a URL da página
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# Mercado Livre OAuth
# 1. Acesse https://developers.mercadolivre.com.br e crie um app
# 2. Configure o Redirect URI: https://phrepresentante.com.br/api/ml/callback
#    (para dev local: http://localhost:3000/api/ml/callback)
# 3. Copie o App ID e o Secret abaixo
ML_APP_ID=SEU_APP_ID
ML_CLIENT_SECRET=SEU_CLIENT_SECRET
ML_REDIRECT_URI=https://phrepresentante.com.br/api/ml/callback
